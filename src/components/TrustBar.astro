---
import { site } from '../data/site.ts';
---

<section class="trust reveal" aria-label="Por qué Ossinova">
  <div class="container trust__inner">
    {
      site.trust.map((item, i) => (
        <div class="trust__item">
          <span class="trust__num">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="trust__title">{item.title}</h3>
            <p class="trust__text">{item.text}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust {
    border-bottom: 1px solid var(--line);
    background: var(--bg-alt);
  }

  .trust__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .trust__item {
    display: flex;
    gap: 1rem;
    padding: 0.4rem clamp(1rem, 3vw, 2.2rem);
  }

  .trust__item + .trust__item {
    border-left: 1px solid var(--line);
  }

  .trust__num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--green);
    letter-spacing: 0.02em;
  }

  .trust__title {
    font-size: 1rem;
    margin: 0 0 0.35rem;
  }

  .trust__text {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .trust__inner {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
    .trust__item {
      padding: 0;
    }
    .trust__item + .trust__item {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-top: 1.6rem;
    }
  }
</style>
