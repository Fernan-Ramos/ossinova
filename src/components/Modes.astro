---
import { site } from '../data/site.ts';
const { modes } = site;
---

<section id="modes" class="section section--gray reveal">
  <div class="container">
    <div class="section__header">
      <span class="section__eyebrow">Modalidades</span>
      <h2>{modes.title}</h2>
      <p>{modes.subtitle}</p>
    </div>

    <div class="modes__grid">
      {
        modes.items.map((item, i) => (
          <article class="mode">
            <span class="mode__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mode__title">{item.title}</h3>
            <p class="mode__text">{item.text}</p>
            <a href="#contact" class="arrow-link mode__link">
              Solicitar información <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .modes__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .mode {
    display: flex;
    flex-direction: column;
    padding: 0 clamp(1.2rem, 3vw, 2.4rem);
  }

  .mode:first-child {
    padding-left: 0;
  }

  .mode + .mode {
    border-left: 1px solid var(--line);
  }

  .mode__num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 2.4rem;
    color: var(--green);
    line-height: 1;
    margin-bottom: 1.2rem;
  }

  .mode__title {
    font-size: 1.25rem;
    margin-bottom: 0.7rem;
  }

  .mode__text {
    color: var(--muted);
    font-size: 0.96rem;
    flex: 1;
    margin-bottom: 1.4rem;
  }

  @media (max-width: 760px) {
    .modes__grid {
      grid-template-columns: 1fr;
    }
    .mode {
      padding: 2rem 0;
    }
    .mode:first-child {
      padding-top: 0;
    }
    .mode + .mode {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
