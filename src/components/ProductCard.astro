---
import type { CollectionEntry } from 'astro:content';
import { MODE_LABEL, CATEGORY_SLUG } from '../data/site.ts';

interface Props {
  product: CollectionEntry<'products'>['data'];
  slug: string;
}

const { product, slug } = Astro.props;
const href = `/catalogo/${CATEGORY_SLUG[product.category]}/${slug}`;

// Resolve the image path: absolute/URL as-is, otherwise from the products folder.
function imageSrc(image?: string | null): string | null {
  if (!image) return null;
  if (image.startsWith('http') || image.startsWith('/')) return image;
  return `/images/products/${image}`;
}

const src = imageSrc(product.image);
---

<article class="card">
  <a class="card__media" href={href} aria-label={product.name}>
    {
      src ? (
        <img src={src} alt={product.name} loading="lazy" />
      ) : (
        <img src="/images/logo-icon.png" alt="" class="card__placeholder" aria-hidden="true" />
      )
    }
  </a>

  <div class="card__body">
    <h3 class="card__title"><a href={href}>{product.name}</a></h3>
    {product.reference && <span class="card__ref">Ref. {product.reference}</span>}
    <p class="card__desc">{product.description}</p>

    <div class="card__modes">
      {product.modes.map((m) => <span class={`badge badge--${m}`}>{MODE_LABEL[m]}</span>)}
    </div>

    <a href={href} class="card__link">Ver ficha <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: transparent;
  }

  .card__media {
    aspect-ratio: 4 / 3;
    background: #fff;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .card:hover .card__media {
    border-color: var(--line-strong);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1.1rem 1.3rem;
    transition: transform 0.35s ease;
  }

  .card:hover .card__media img {
    transform: scale(1.04);
  }

  .card__placeholder {
    width: 42%;
    height: auto;
    object-fit: contain;
    opacity: 0.3;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 0 0;
    flex: 1;
  }

  .card__title {
    margin: 0;
    font-size: 1.1rem;
  }

  .card__title a {
    color: var(--ink);
  }

  .card__title a:hover {
    color: var(--green);
  }

  .card__ref {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card__desc {
    margin: 0.2rem 0;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .card__modes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: auto;
    padding-top: 0.7rem;
  }

  .card__link {
    margin-top: 0.9rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink);
  }

  .card__link:hover {
    color: var(--green);
  }
</style>
