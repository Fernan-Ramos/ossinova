---
import { site } from '../data/site.ts';
const { about } = site;
const [lead, ...rest] = about.paragraphs;
---

<section id="about" class="section reveal">
  <div class="container">
    <div class="section__header">
      <span class="section__eyebrow">Quiénes somos</span>
      <h2>{about.title}</h2>
    </div>

    <div class="about__grid">
      <div class="about__text">
        <p class="about__lead">{lead}</p>
        {rest.map((p) => <p>{p}</p>)}
      </div>

      <aside class="about__goal">
        <h3 class="about__goal-title">{about.goal.title}</h3>
        <p>{about.goal.text}</p>
        <ul class="about__modes">
          <li><span>01</span> Renting de larga duración</li>
          <li><span>02</span> Renting de corta duración</li>
          <li><span>03</span> Venta del material</li>
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .about__lead {
    font-size: 1.3rem;
    line-height: 1.55;
    color: var(--ink);
    font-weight: 500;
    margin-bottom: 1.4rem;
  }

  .about__text p:not(.about__lead) {
    color: var(--muted);
  }

  .about__goal {
    padding-top: 1.4rem;
    border-top: 2px solid var(--green);
  }

  .about__goal-title {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--green);
    margin-bottom: 0.9rem;
  }

  .about__goal > p {
    color: var(--muted);
    font-size: 0.98rem;
  }

  .about__modes {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .about__modes li {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
    font-weight: 600;
    color: var(--ink);
  }

  .about__modes span {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    color: var(--green);
  }

  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
