---
import { site } from '../data/site.ts';
const { about } = site;
---

<section id="about" class="section reveal">
  <div class="container about">
    <div class="about__header">
      <span class="section__eyebrow">Quiénes somos</span>
      <h2>{about.title}</h2>
    </div>

    <div class="about__grid">
      <div class="about__text">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <aside class="about__goal">
        <h3>{about.goal.title}</h3>
        <p>{about.goal.text}</p>
        <ul class="about__modes">
          <li>Renting de larga duración</li>
          <li>Renting de corta duración</li>
          <li>Venta del material</li>
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .about__header {
    text-align: center;
    margin-bottom: 2.6rem;
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr;
    gap: 2.5rem;
    align-items: start;
  }

  .about__goal {
    background: var(--green-soft);
    border-radius: var(--radius);
    padding: 1.8rem;
    border-left: 4px solid var(--green);
  }

  .about__goal h3 {
    color: var(--green-dark);
  }

  .about__modes {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: grid;
    gap: 0.6rem;
  }

  .about__modes li {
    position: relative;
    padding-left: 1.6rem;
    font-weight: 600;
    color: var(--gray);
  }

  .about__modes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
  }

  @media (max-width: 820px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
