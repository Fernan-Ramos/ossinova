---
import { site } from '../data/site.ts';
const { hero } = site;
---

<section id="home" class="hero">
  <div class="hero__shape" data-wheel aria-hidden="true">
    <svg class="hero__blob" viewBox="0 0 100 100" preserveAspectRatio="none">
      <defs>
        <linearGradient id="ossHeroGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#e9f5fb" />
          <stop offset="55%" stop-color="#c4e6ea" />
          <stop offset="100%" stop-color="#9fd6dc" />
        </linearGradient>
      </defs>
      <path
        d="M72 0 C60 18 40 36 40 60 C40 82 58 92 63 100 L100 100 L100 0 Z"
        fill="url(#ossHeroGrad)"
      />
    </svg>
    <img src="/images/logo-icon.png" alt="" class="hero__logo" />
  </div>

  <div class="container">
    <div class="hero__copy">
      <span class="hero__eyebrow">Ossinova Surgical Group</span>
      <h1 class="hero__title">{hero.title}</h1>
      <p class="hero__subtitle">{hero.subtitle}</p>
      <div class="hero__actions">
        <a href={hero.primaryCta.anchor} class="hero-cta">
          <span class="hero-cta__icon" aria-hidden="true">→</span>
          <span>{hero.primaryCta.label}</span>
        </a>
        <a href={hero.secondaryCta.anchor} class="arrow-link">{hero.secondaryCta.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hero .container {
    position: relative;
    z-index: 2;
    /* let pointer events fall through to the shape, except on the copy */
    pointer-events: none;
  }

  .hero__copy {
    max-width: 560px;
    padding: clamp(3rem, 7vw, 6rem) 0;
    pointer-events: auto;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 1.6rem;
  }

  .hero__eyebrow::before {
    content: '';
    width: 26px;
    height: 1px;
    background: var(--green);
  }

  .hero__title {
    margin-bottom: 1.4rem;
    max-width: 14ch;
  }

  .hero__subtitle {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--muted);
    max-width: 44ch;
    margin-bottom: 2.4rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.8rem;
  }

  /* Organic colored shape, bleeding to the right edge */
  .hero__shape {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 52%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: clamp(2rem, 6vw, 5rem);
  }

  /* Organic S-curved shape (bleeds to top/right/bottom). */
  .hero__blob {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero__logo {
    position: relative;
    z-index: 1;
    width: min(240px, 40%);
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__logo {
      animation: hero-spin 16s linear infinite;
    }
  }

  @keyframes hero-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Primary CTA with circular arrow */
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.45rem 1.7rem 0.45rem 0.45rem;
    background: var(--green);
    color: #fff;
    font-weight: 600;
    font-size: 0.98rem;
    border-radius: 999px;
    box-shadow: 0 10px 26px rgba(1, 115, 125, 0.26);
    transition: transform 0.18s ease, box-shadow 0.22s ease, background 0.18s ease;
  }

  .hero-cta__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #fff;
    color: var(--green);
    font-size: 1.15rem;
    transition: transform 0.2s ease;
  }

  .hero-cta:hover {
    background: var(--green-dark);
    transform: translateY(-2px);
    box-shadow: 0 16px 34px rgba(1, 115, 125, 0.32);
  }

  .hero-cta:hover .hero-cta__icon {
    transform: translateX(4px);
  }

  @media (max-width: 980px) {
    .hero__shape {
      position: relative;
      inset: auto;
      width: 100%;
      height: clamp(240px, 40vh, 340px);
      padding-right: 12%;
    }
    .hero__copy {
      padding: 2.5rem 0 3rem;
    }
  }
</style>
