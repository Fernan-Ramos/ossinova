---
import { site } from '../data/site.ts';
const { hero } = site;
---

<section id="home" class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="hero__eyebrow">Ossinova Surgical Group</span>
      <h1 class="hero__title">{hero.title}</h1>
      <p class="hero__subtitle">{hero.subtitle}</p>
      <div class="hero__actions">
        <a href={hero.primaryCta.anchor} class="btn btn--primary">
          {hero.primaryCta.label} <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a href={hero.secondaryCta.anchor} class="btn btn--secondary">{hero.secondaryCta.label}</a>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__panel">
        <img src="/images/logo-icon.png" alt="" class="hero__logo" aria-hidden="true" />

        <span class="hero__chip hero__chip--tl">
          <span class="hero__chip-dot"></span> Titanio Ti-6Al-4V ELI
        </span>
        <span class="hero__chip hero__chip--br">
          <span class="hero__chip-dot"></span> Diseñado en quirófano
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 1.6rem;
  }

  .hero__eyebrow::before {
    content: '';
    width: 26px;
    height: 1px;
    background: var(--green);
  }

  .hero__title {
    margin-bottom: 1.4rem;
    max-width: 15ch;
  }

  .hero__subtitle {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--muted);
    max-width: 46ch;
    margin-bottom: 2.4rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.6rem;
  }

  /* Visual panel — swap the gradient for a real photo later. */
  .hero__panel {
    position: relative;
    aspect-ratio: 5 / 4;
    border-radius: 28px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background:
      radial-gradient(120% 100% at 18% 12%, rgba(1, 115, 125, 0.16), transparent 55%),
      radial-gradient(120% 120% at 88% 92%, rgba(141, 212, 234, 0.38), transparent 55%),
      linear-gradient(158deg, #f1f8f8 0%, #ffffff 60%);
    border: 1px solid var(--line);
  }

  .hero__logo {
    width: min(300px, 62%);
    height: auto;
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__logo {
      animation: hero-float 6s ease-in-out infinite;
    }
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-16px) rotate(-2.5deg);
    }
  }

  /* The mark is a wheel — spin it on hover over the visual. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__panel:hover .hero__logo {
      animation: hero-spin 4s linear infinite;
    }
  }

  @keyframes hero-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Floating glass labels */
  .hero__chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.95rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    box-shadow: 0 10px 30px rgba(1, 115, 125, 0.12);
  }

  .hero__chip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
  }

  .hero__chip--tl {
    top: 8%;
    left: 6%;
  }

  .hero__chip--br {
    bottom: 8%;
    right: 6%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__chip--tl {
      animation: hero-float 6s ease-in-out infinite;
    }
    .hero__chip--br {
      animation: hero-float 7s ease-in-out infinite reverse;
    }
  }

  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__visual {
      order: -1;
    }
    .hero__panel {
      aspect-ratio: 16 / 10;
    }
    .hero__chip {
      font-size: 0.75rem;
    }
  }
</style>
