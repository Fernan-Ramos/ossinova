---
import { site } from '../data/site.ts';
const { hero } = site;
---

<section id="home" class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="hero__eyebrow">Ossinova Surgical Group</span>
      <h1 class="hero__title">{hero.title}</h1>
      <p class="hero__subtitle">{hero.subtitle}</p>
      <div class="hero__actions">
        <a href={hero.primaryCta.anchor} class="btn btn--primary">{hero.primaryCta.label}</a>
        <a href={hero.secondaryCta.anchor} class="arrow-link"
          >{hero.secondaryCta.label} <span aria-hidden="true">→</span></a
        >
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <img src="/images/logo-icon.png" alt="" class="hero__logo" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero::before {
    /* very soft brand glow, not a colored box */
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 55%;
    height: 120%;
    background: radial-gradient(closest-side, rgba(1, 115, 125, 0.08), transparent 70%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: center;
    gap: 3rem;
    padding-top: clamp(3.5rem, 8vw, 6.5rem);
    padding-bottom: clamp(3.5rem, 8vw, 6.5rem);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 1.6rem;
  }

  .hero__eyebrow::before {
    content: '';
    width: 26px;
    height: 1px;
    background: var(--green);
  }

  .hero__title {
    margin-bottom: 1.4rem;
    max-width: 15ch;
  }

  .hero__subtitle {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--muted);
    max-width: 46ch;
    margin-bottom: 2.4rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.6rem;
  }

  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .hero__logo {
    width: min(320px, 78%);
    height: auto;
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__logo {
      animation: hero-float 6s ease-in-out infinite;
    }
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-16px) rotate(-2.5deg);
    }
  }

  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .hero__visual {
      order: -1;
      justify-content: flex-start;
    }
    .hero__logo {
      width: min(150px, 40%);
    }
  }
</style>
