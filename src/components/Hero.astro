---
import { site } from '../data/site.ts';
const { hero } = site;
---

<section id="home" class="hero">
  <div class="hero__shape" data-wheel aria-hidden="true">
    <svg class="hero__blob" viewBox="0 0 100 100" preserveAspectRatio="none">
      <defs>
        <radialGradient id="ossHeroMesh" cx="72%" cy="14%" r="95%">
          <stop offset="0%" stop-color="#f2fafc" />
          <stop offset="42%" stop-color="#cfe9ed" />
          <stop offset="100%" stop-color="#7ec5cc" />
          <animate attributeName="cx" values="72%;54%;68%;72%" dur="16s" repeatCount="indefinite" />
          <animate attributeName="cy" values="14%;30%;10%;14%" dur="20s" repeatCount="indefinite" />
        </radialGradient>
        <linearGradient id="ossHeroDepth" x1="40%" y1="0%" x2="70%" y2="100%">
          <stop offset="0%" stop-color="#01737d" stop-opacity="0" />
          <stop offset="100%" stop-color="#01737d" stop-opacity="0.28" />
        </linearGradient>
      </defs>
      <path d="M72 0 C60 18 40 36 40 60 C40 82 58 92 63 100 L100 100 L100 0 Z" fill="url(#ossHeroMesh)" />
      <path d="M72 0 C60 18 40 36 40 60 C40 82 58 92 63 100 L100 100 L100 0 Z" fill="url(#ossHeroDepth)" />
    </svg>

    <span class="hero__logo-wrap" data-parallax="0.5">
      <img src="/images/logo-icon.png" alt="" class="hero__logo" />
    </span>
  </div>

  <div class="container">
    <div class="hero__copy">
      <img src="/images/logo-icon.png" alt="" class="hero__copy-logo" aria-hidden="true" />
      <span class="hero__eyebrow">Ossinova Surgical Group</span>
      <h1 class="hero__title">
        {hero.title} <span class="hero__title-accent">{hero.titleAccent}</span>
      </h1>
      <p class="hero__subtitle">{hero.subtitle}</p>
      <div class="hero__actions">
        <a href={hero.primaryCta.anchor} class="hero-cta">
          <span class="hero-cta__icon" aria-hidden="true">→</span>
          <span>{hero.primaryCta.label}</span>
        </a>
        <a href={hero.secondaryCta.anchor} class="arrow-link">{hero.secondaryCta.label}</a>
      </div>

      <ul class="hero__signals">
        <li>Titanio Ti-6Al-4V ELI</li>
        <li>Diseñado en quirófano</li>
        <li>Renting o venta</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hero .container {
    position: relative;
    z-index: 2;
    /* let pointer events fall through to the shape, except on the copy */
    pointer-events: none;
  }

  .hero__copy {
    max-width: 560px;
    padding: clamp(3rem, 7vw, 6rem) 0;
    pointer-events: auto;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 1.6rem;
  }

  .hero__eyebrow::before {
    content: '';
    width: 26px;
    height: 1px;
    background: var(--green);
  }

  .hero__title {
    margin-bottom: 1.3rem;
    max-width: 15ch;
  }

  .hero__title-accent {
    color: var(--green);
  }

  .hero__subtitle {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--muted);
    max-width: 44ch;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.8rem;
  }

  /* Mini trust signals under the CTAs */
  .hero__signals {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.5rem;
    list-style: none;
    margin: 2.6rem 0 0;
    padding: 1.6rem 0 0;
    border-top: 1px solid var(--line);
  }

  .hero__signals li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
  }

  .hero__signals li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    flex-shrink: 0;
  }

  /* Organic colored shape, bleeding to the right edge */
  .hero__shape {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 52%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 12%;
  }

  /* Organic S-curved shape (bleeds to top/right/bottom). */
  .hero__blob {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero__logo-wrap {
    position: relative;
    z-index: 1;
    display: block;
    width: min(240px, 40%);
    will-change: transform;
    transition: transform 0.25s ease-out;
  }

  .hero__logo {
    display: block;
    width: 100%;
    height: auto;
  }

  /* mobile-only logo shown with the text (no geometric shape) */
  .hero__copy-logo {
    display: none;
    width: 92px;
    height: auto;
    margin-bottom: 1.4rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__logo,
    .hero__copy-logo {
      animation: hero-spin 12s linear infinite;
    }
  }

  @keyframes hero-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Primary CTA with circular arrow */
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.45rem 1.7rem 0.45rem 0.45rem;
    background: var(--green);
    color: #fff;
    font-weight: 600;
    font-size: 0.98rem;
    border-radius: 999px;
    box-shadow: 0 10px 26px rgba(1, 115, 125, 0.26);
    transition: transform 0.18s ease, box-shadow 0.22s ease, background 0.18s ease;
  }

  .hero-cta__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #fff;
    color: var(--green);
    font-size: 1.15rem;
    transition: transform 0.2s ease;
  }

  .hero-cta:hover {
    background: var(--green-dark);
    transform: translateY(-2px);
    box-shadow: 0 16px 34px rgba(1, 115, 125, 0.32);
  }

  .hero-cta:hover .hero-cta__icon {
    transform: translateX(4px);
  }

  @media (max-width: 980px) {
    /* drop the geometric shape; combine logo + text in one centered column */
    .hero__shape {
      display: none;
    }
    .hero__copy {
      max-width: 640px;
      margin: 0 auto;
      padding: 3rem 0 3.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .hero__copy-logo {
      display: block;
    }
    .hero__title,
    .hero__subtitle {
      max-width: none;
    }
    .hero__actions {
      justify-content: center;
    }
  }
</style>

<script>
  // Mouse parallax: layers move at different depths for a subtle 3D feel.
  function initHeroParallax() {
    const hero = document.querySelector<HTMLElement>('.hero');
    const shape = hero?.querySelector<HTMLElement>('.hero__shape');
    const logo = hero?.querySelector<HTMLElement>('.hero__logo-wrap');
    if (!hero || !shape || !logo) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    let raf = 0;
    const onMove = (e: MouseEvent) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const r = hero.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5; // -0.5 .. 0.5
        const py = (e.clientY - r.top) / r.height - 0.5;
        logo.style.transform = `translate(${px * 30}px, ${py * 30}px)`;
      });
    };
    const reset = () => {
      logo.style.transform = '';
    };
    hero.addEventListener('mousemove', onMove);
    hero.addEventListener('mouseleave', reset);
  }

  document.addEventListener('astro:page-load', initHeroParallax);
</script>
