---
import { site } from '../data/site.ts';
const { hero } = site;
---

<section id="home" class="hero">
  <div class="hero__shape" data-wheel aria-hidden="true">
    <img src="/images/logo-icon.png" alt="" class="hero__logo" />
  </div>

  <div class="container">
    <div class="hero__copy">
      <span class="hero__eyebrow">Ossinova Surgical Group</span>
      <h1 class="hero__title">{hero.title}</h1>
      <p class="hero__subtitle">{hero.subtitle}</p>
      <div class="hero__actions">
        <a href={hero.primaryCta.anchor} class="hero-cta">
          <span class="hero-cta__icon" aria-hidden="true">→</span>
          <span>{hero.primaryCta.label}</span>
        </a>
        <a href={hero.secondaryCta.anchor} class="arrow-link">{hero.secondaryCta.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hero .container {
    position: relative;
    z-index: 2;
    /* let pointer events fall through to the shape, except on the copy */
    pointer-events: none;
  }

  .hero__copy {
    max-width: 560px;
    padding: clamp(3rem, 7vw, 6rem) 0;
    pointer-events: auto;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 1.6rem;
  }

  .hero__eyebrow::before {
    content: '';
    width: 26px;
    height: 1px;
    background: var(--green);
  }

  .hero__title {
    margin-bottom: 1.4rem;
    max-width: 14ch;
  }

  .hero__subtitle {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--muted);
    max-width: 44ch;
    margin-bottom: 2.4rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.8rem;
  }

  /* Organic colored shape, bleeding to the right edge */
  .hero__shape {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 46%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(100% 80% at 24% 14%, rgba(255, 255, 255, 0.6), transparent 60%),
      linear-gradient(150deg, #e6f4fa 0%, #c4e6ea 52%, #9fd6dc 100%);
    /* full-bleed to the right edge; only the left edge is curved.
       Bigger top-left curve makes it cut in more at the top. */
    border-top-left-radius: 80% 72%;
    border-bottom-left-radius: 45% 28%;
  }

  .hero__logo {
    width: min(270px, 44%);
    height: auto;
  }

  /* Primary CTA with circular arrow */
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.45rem 1.7rem 0.45rem 0.45rem;
    background: var(--green);
    color: #fff;
    font-weight: 600;
    font-size: 0.98rem;
    border-radius: 999px;
    box-shadow: 0 10px 26px rgba(1, 115, 125, 0.26);
    transition: transform 0.18s ease, box-shadow 0.22s ease, background 0.18s ease;
  }

  .hero-cta__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #fff;
    color: var(--green);
    font-size: 1.15rem;
    transition: transform 0.2s ease;
  }

  .hero-cta:hover {
    background: var(--green-dark);
    transform: translateY(-2px);
    box-shadow: 0 16px 34px rgba(1, 115, 125, 0.32);
  }

  .hero-cta:hover .hero-cta__icon {
    transform: translateX(4px);
  }

  @media (max-width: 980px) {
    .hero__shape {
      position: relative;
      inset: auto;
      width: 100%;
      height: clamp(240px, 40vh, 340px);
      border-radius: 0 0 36px 36px;
    }
    .hero__copy {
      padding: 2.5rem 0 3rem;
    }
  }
</style>

<script>
  // The mark is a wheel: spin it while hovering the shape, and freeze it at
  // whatever angle it reached when the pointer leaves (no snap back).
  function initHeroWheel() {
    const shape = document.querySelector<HTMLElement>('[data-wheel]');
    const logo = shape?.querySelector<HTMLElement>('.hero__logo');
    if (!shape || !logo) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let angle = 0;
    let last: number | null = null;
    let raf: number | null = null;
    let hovering = false;
    const SPEED = 0.12; // degrees per millisecond (~1 turn / 3s)

    function tick(t: number) {
      if (last === null) last = t;
      angle = (angle + (t - last) * SPEED) % 360;
      last = t;
      logo!.style.transform = `rotate(${angle}deg)`;
      if (hovering) raf = requestAnimationFrame(tick);
    }

    shape.addEventListener('mouseenter', () => {
      hovering = true;
      last = null;
      raf = requestAnimationFrame(tick);
    });

    shape.addEventListener('mouseleave', () => {
      hovering = false;
      if (raf) cancelAnimationFrame(raf);
    });
  }

  document.addEventListener('astro:page-load', initHeroWheel);
</script>
