---
import { site } from '../data/site.ts';
const { hero } = site;
---

<section id="home" class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="hero__eyebrow">Ossinova Surgical Group</span>
      <h1 class="hero__title">{hero.title}</h1>
      <p class="hero__subtitle">{hero.subtitle}</p>
      <div class="hero__actions">
        <a href={hero.primaryCta.anchor} class="btn btn--primary">{hero.primaryCta.label}</a>
        <a href={hero.secondaryCta.anchor} class="btn btn--secondary">{hero.secondaryCta.label}</a>
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <img src="/images/logo-icon.png" alt="" class="hero__logo" />
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(160deg, var(--green-soft) 0%, #fff 60%);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 2.5rem;
    padding-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  .hero__eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 1rem;
  }

  .hero__title {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    color: var(--gray);
    margin-bottom: 1.1rem;
  }

  .hero__subtitle {
    font-size: 1.1rem;
    max-width: 46ch;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .hero__logo {
    width: min(340px, 80%);
    height: auto;
    filter: drop-shadow(0 18px 40px rgba(1, 115, 125, 0.18));
  }

  @media (max-width: 820px) {
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero__subtitle {
      margin-left: auto;
      margin-right: auto;
    }
    .hero__actions {
      justify-content: center;
    }
    .hero__visual {
      order: -1;
    }
    .hero__logo {
      width: min(200px, 55%);
    }
  }
</style>
