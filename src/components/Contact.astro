---
import { site, MODE_LABEL } from '../data/site.ts';
const { contact } = site;

const mailHref = `mailto:${contact.email}`;
const whatsappHref = `https://wa.me/${contact.whatsapp}`;
const configured = contact.formUrl.trim() !== '';
---

<section id="contact" class="section reveal">
  <div class="container">
    <div class="section__header">
      <span class="section__eyebrow">Contacto</span>
      <h2>{contact.title}</h2>
      <p>{contact.text}</p>
    </div>

    <div class="contact">
      <!-- Form -->
      <form class="contact__form" data-form action={contact.formUrl} method="POST">
        {
          !configured && (
            <p class="contact__notice">Formulario pendiente de configurar.</p>
          )
        }

        <div class="contact__row">
          <div class="field">
            <label for="name">Nombre *</label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="clinic">Clínica / centro</label>
            <input type="text" id="clinic" name="clinic" autocomplete="organization" />
          </div>
        </div>

        <div class="contact__row">
          <div class="field">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="phone">Teléfono</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" />
          </div>
        </div>

        <div class="field">
          <label for="mode">Modalidad de interés</label>
          <select id="mode" name="mode">
            <option value="">Sin especificar</option>
            <option value={MODE_LABEL['rental-long']}>{MODE_LABEL['rental-long']}</option>
            <option value={MODE_LABEL['rental-short']}>{MODE_LABEL['rental-short']}</option>
            <option value={MODE_LABEL['sale']}>{MODE_LABEL['sale']}</option>
          </select>
        </div>

        <div class="field">
          <label for="message">Mensaje *</label>
          <textarea id="message" name="message" rows="4" required
            placeholder="Cuéntanos qué material necesitas, cantidades, plazos..."></textarea>
        </div>

        <!-- Anti-spam honeypot -->
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

        <button type="submit" class="btn btn--primary contact__submit" disabled={!configured} data-form-btn>
          <span class="contact__spinner" aria-hidden="true"></span>
          <span class="contact__submit-label">Enviar consulta</span>
        </button>

        <p class="contact__status" data-form-status hidden></p>
      </form>

      <!-- Direct contact -->
      <aside class="contact__cards">
        <a href={mailHref} class="contact__card">
          <span class="contact__label">Email</span>
          <span class="contact__value">{contact.email}</span>
        </a>
        <a href={whatsappHref} class="contact__card" target="_blank" rel="noopener">
          <span class="contact__label">WhatsApp</span>
          <span class="contact__value">{contact.phone}</span>
        </a>
        <a href={contact.instagram} class="contact__card contact__card--ig" target="_blank" rel="noopener">
          <span class="contact__label">Instagram</span>
          <span class="contact__value">{contact.instagramHandle}</span>
        </a>
        <div class="contact__card contact__card--static">
          <span class="contact__label">Ubicación</span>
          <span class="contact__value">{contact.city}</span>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 2.5rem;
    align-items: start;
  }

  .contact__form {
    display: grid;
    gap: 1rem;
  }

  .contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .contact__notice {
    margin: 0;
    padding: 0.8rem 1rem;
    background: #fdf4e0;
    border: 1px solid #f0dca8;
    border-radius: 10px;
    font-size: 0.85rem;
    color: #8a6a1c;
  }

  .contact__notice code {
    background: rgba(0, 0, 0, 0.06);
    padding: 0.05em 0.35em;
    border-radius: 4px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .field input,
  .field select,
  .field textarea {
    font-family: inherit;
    font-size: 1rem;
    color: var(--ink);
    padding: 0.55rem 0.1rem;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    transition: border-color 0.15s ease;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--green);
  }

  .field textarea {
    resize: vertical;
  }

  .contact__submit {
    justify-self: start;
    margin-top: 0.3rem;
  }

  .contact__submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .contact__spinner {
    display: none;
    width: 15px;
    height: 15px;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  .contact__form[data-sending] .contact__spinner {
    display: inline-block;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .contact__status {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .contact__status[data-state='ok'] {
    color: #4d7c2f;
  }

  .contact__status[data-state='error'] {
    color: #c0392b;
  }

  .contact__cards {
    display: grid;
    gap: 0;
    align-content: start;
    border-top: 1px solid var(--line);
  }

  .contact__card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.16s ease;
  }

  a.contact__card:hover {
    padding-left: 0.6rem;
  }

  .contact__label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    color: var(--muted);
  }

  .contact__value {
    font-weight: 600;
    color: var(--ink);
  }

  a.contact__card:hover .contact__value {
    color: var(--green);
  }

  @media (max-width: 820px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 460px) {
    .contact__row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>('.contact__form[data-form]');
    if (!form) return;
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const endpoint = form.getAttribute('action') ?? '';

    form.addEventListener('submit', async (event) => {
      if (!endpoint) return; // not configured: let it do nothing
      event.preventDefault();

    // Honeypot: silently ignore bots.
    const gotcha = form.querySelector<HTMLInputElement>('input[name="_gotcha"]');
    if (gotcha && gotcha.value) return;

    form.setAttribute('data-sending', 'true');
    if (status) status.hidden = true;

    try {
      const data = new FormData(form);
      await fetch(endpoint, { method: 'POST', body: data, mode: 'no-cors' });
      // Apps Script responds opaque with no-cors; assume success on resolve.
      form.reset();
      if (status) {
        status.textContent = '¡Gracias! Hemos recibido tu consulta y te responderemos en breve.';
        status.setAttribute('data-state', 'ok');
        status.hidden = false;
      }
    } catch {
      if (status) {
        status.textContent = 'No se ha podido enviar. Escríbenos por email o WhatsApp.';
        status.setAttribute('data-state', 'error');
        status.hidden = false;
      }
    } finally {
      form.removeAttribute('data-sending');
    }
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>
