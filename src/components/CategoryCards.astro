---
import { getCollection } from 'astro:content';
import {
  CATEGORY_LABEL,
  CATEGORY_DESC,
  CATEGORY_SLUG,
  CATEGORY_ORDER,
} from '../data/site.ts';

const entries = await getCollection('products');

const categories = CATEGORY_ORDER.map((key) => ({
  key,
  label: CATEGORY_LABEL[key],
  desc: CATEGORY_DESC[key],
  slug: CATEGORY_SLUG[key],
  count: entries.filter((e) => e.data.category === key).length,
})).filter((c) => c.count > 0);
---

<ul class="cats">
  {
    categories.map((cat) => (
      <li>
        <a class="cat" href={`/catalogo/${cat.slug}`}>
          <span class="cat__name">
            {cat.label}
            <span class="cat__count">{cat.count}</span>
          </span>
          <span class="cat__desc">{cat.desc}</span>
          <span class="cat__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .cats {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .cat {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr) auto;
    align-items: center;
    gap: 2rem;
    padding: 1.7rem 0.5rem 1.7rem 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.2s ease, background 0.2s ease;
  }

  .cat:hover {
    padding-left: 1rem;
    background: var(--bg-alt);
  }

  .cat__name {
    display: inline-flex;
    align-items: baseline;
    gap: 0.7rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.5vw, 1.9rem);
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .cat:hover .cat__name {
    color: var(--green);
  }

  .cat__count {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
  }

  .cat__desc {
    color: var(--muted);
    font-size: 0.98rem;
  }

  .cat__arrow {
    color: var(--green);
    font-size: 1.2rem;
    transition: transform 0.2s ease;
  }

  .cat:hover .cat__arrow {
    transform: translateX(6px);
  }

  @media (max-width: 760px) {
    .cat {
      grid-template-columns: 1fr auto;
      gap: 0.5rem 1rem;
    }
    .cat__desc {
      grid-column: 1 / -1;
      font-size: 0.9rem;
    }
  }
</style>
