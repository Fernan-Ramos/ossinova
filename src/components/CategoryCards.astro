---
import { getCollection } from 'astro:content';
import {
  CATEGORY_LABEL,
  CATEGORY_DESC,
  CATEGORY_SLUG,
  CATEGORY_ORDER,
} from '../data/site.ts';

const entries = await getCollection('products');

// Count products per category and keep only categories that have products.
const categories = CATEGORY_ORDER.map((key) => ({
  key,
  label: CATEGORY_LABEL[key],
  desc: CATEGORY_DESC[key],
  slug: CATEGORY_SLUG[key],
  count: entries.filter((e) => e.data.category === key).length,
})).filter((c) => c.count > 0);
---

<div class="cats">
  {
    categories.map((cat) => (
      <a class="cat" href={`/catalogo/${cat.slug}`}>
        <div class="cat__top">
          <span class="cat__name">{cat.label}</span>
          <span class="cat__count">{cat.count}</span>
        </div>
        <p class="cat__desc">{cat.desc}</p>
        <span class="cat__link">
          Ver sección <span aria-hidden="true">→</span>
        </span>
      </a>
    ))
  }
</div>

<style>
  .cats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.2rem;
  }

  .cat {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
    border-left: 4px solid var(--green);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .cat:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .cat__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .cat__name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--gray);
  }

  .cat__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 26px;
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--green-soft);
    color: var(--green-dark);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .cat__desc {
    margin: 0;
    font-size: 0.9rem;
    flex: 1;
  }

  .cat__link {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--green);
  }
</style>
