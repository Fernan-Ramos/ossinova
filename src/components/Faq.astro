---
import { site } from '../data/site.ts';
const { faq } = site;
---

<section id="faq" class="section section--gray reveal">
  <div class="container faq">
    <div class="section__header">
      <span class="section__eyebrow">FAQ</span>
      <h2>{faq.title}</h2>
      <p>{faq.subtitle}</p>
    </div>

    <div class="faq__list">
      {
        faq.items.map((item) => (
          <details class="faq__item">
            <summary class="faq__question">
              <span>{item.q}</span>
              <span class="faq__chevron" aria-hidden="true" />
            </summary>
            <div class="faq__answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__list {
    max-width: 800px;
    border-top: 1px solid var(--line);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0.2rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    transition: color 0.15s ease;
  }

  .faq__question:hover {
    color: var(--green);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__chevron {
    position: relative;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
  }

  .faq__chevron::before,
  .faq__chevron::after {
    content: '';
    position: absolute;
    background: var(--green);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .faq__chevron::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }

  .faq__chevron::after {
    left: 50%;
    top: 0;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
  }

  .faq__item[open] .faq__chevron::after {
    opacity: 0;
    transform: translateX(-50%) rotate(90deg);
  }

  .faq__answer {
    padding: 0 3rem 1.6rem 0.2rem;
  }

  .faq__answer p {
    margin: 0;
    color: var(--muted);
  }
</style>
