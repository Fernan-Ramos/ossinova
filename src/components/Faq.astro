---
import { site } from '../data/site.ts';
const { faq } = site;
---

<section id="faq" class="section section--gray reveal">
  <div class="container faq">
    <div class="section__header">
      <span class="section__eyebrow">FAQ</span>
      <h2>{faq.title}</h2>
      <p>{faq.subtitle}</p>
    </div>

    <div class="faq__list">
      {
        faq.items.map((item) => (
          <details class="faq__item">
            <summary class="faq__question">
              <span>{item.q}</span>
              <span class="faq__chevron" aria-hidden="true" />
            </summary>
            <div class="faq__answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__list {
    max-width: 760px;
    margin: 0 auto;
    display: grid;
    gap: 0.8rem;
  }

  .faq__item {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.4rem;
    font-weight: 600;
    color: var(--gray);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__chevron {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    border-right: 2px solid var(--green);
    border-bottom: 2px solid var(--green);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    margin-top: -4px;
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(-135deg);
    margin-top: 4px;
  }

  .faq__answer {
    padding: 0 1.4rem 1.2rem;
  }

  .faq__answer p {
    margin: 0;
  }
</style>
